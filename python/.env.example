# Copy to .env and fill in values:
#   cp .env.example .env

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional OpenRouter settings
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TITLE=agentspace-rag
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://localhost

# Required — Chroma Cloud (https://www.trychroma.com/)
# From the dashboard Connect panel:
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# Optional region host (only if not us-east-1), e.g. europe-west1.gcp.trychroma.com
# CHROMA_HOST=
# CHROMA_PORT=443
# CHROMA_UPSERT_BATCH=100

# Character-by-character typing pace for streamed answers (milliseconds per char)
# STREAM_CHAR_DELAY_MS=12

# Optional RAG tuning
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_MAX_SOURCE_CHARS=150000
# RAG_MAX_PDF_PAGES=120
# RAG_CONTEXT_DOC_CHARS=1400
# RAG_CONTEXT_TOTAL_CHARS=9000
# RAG_MAX_QUERY_VARIANTS=5

# Optional CORS origins for the API (comma-separated). Defaults include Vite dev.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
