# Copy to .env and fill in values:
#   cp .env.example .env

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TITLE=agentspace-rag
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173

# Local Chroma (PersistentClient)
CHROMA_PATH=.chroma
CHROMA_UPSERT_BATCH=100

# CLI streaming pace (ms per character)
STREAM_CHAR_DELAY_MS=12

# RAG tuning
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_SOURCE_CHARS=150000
RAG_MAX_PDF_PAGES=120
RAG_CONTEXT_DOC_CHARS=1400
RAG_CONTEXT_TOTAL_CHARS=9000
RAG_MAX_QUERY_VARIANTS=5

# Vite frontend origins for CORS (browser Origin — not the API URL)
VITE_FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
